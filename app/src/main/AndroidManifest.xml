<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Noetig, um Audioeffekte an die Ausgabe zu haengen (normale Berechtigung, automatisch erteilt) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Nur fuer die Echtzeit-Anzeige (Android-Visualizer-API). Es wird NICHT aufgenommen. Optional. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Nur fuer den echten Namen des Bluetooth-Geraets ab Android 12. Optional. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SBL4A2">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
